# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
NODE_ENV=development
PORT=3000

# Llave para firmar los tokens (mínimo 32 caracteres aleatorios).
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Ruta del archivo de base de datos SQLite
DB_PATH=./data/skin_amelia.db

# Cuenta de administradora inicial (se crea al arrancar si no existe)
ADMIN_NOMBRE=Administradora
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Orígenes permitidos por CORS, separados por coma (vacío = ninguno)
CORS_ORIGINS=
